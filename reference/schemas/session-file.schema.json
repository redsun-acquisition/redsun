{
  "$defs": {
    "CatalogConfig": {
      "additionalProperties": false,
      "description": "The catalog a session keeps in `<base_dir>/<session>/catalog`.",
      "properties": {
        "readable": {
          "default": [],
          "description": "Directories the catalog may read from besides the session's own.",
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Readable",
          "type": "array"
        }
      },
      "title": "CatalogConfig",
      "type": "object"
    },
    "ColumnEntry": {
      "additionalProperties": false,
      "description": "Views stacked in a layout, as a session file writes them.",
      "properties": {
        "column": {
          "description": "What shares the space, top to bottom.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/RowEntry"
              },
              {
                "$ref": "#/$defs/ColumnEntry"
              },
              {
                "$ref": "#/$defs/TabsEntry"
              },
              {}
            ]
          },
          "title": "Column",
          "type": "array"
        },
        "sizes": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One positive weight per child.",
          "title": "Sizes"
        }
      },
      "required": [
        "column"
      ],
      "title": "ColumnEntry",
      "type": "object"
    },
    "ComponentEntry": {
      "additionalProperties": true,
      "description": "A component's entry: the plugin it comes from, and its constructor keywords.\n\nEvery key besides the plugin keys is a keyword for the component's\nconstructor, which checks them when the component is built.",
      "properties": {
        "plugin_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The plugin whose manifest lists the component.",
          "title": "Plugin Name"
        },
        "plugin_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The component's id in that manifest.",
          "title": "Plugin Id"
        }
      },
      "title": "ComponentEntry",
      "type": "object"
    },
    "DeviceEntry": {
      "additionalProperties": true,
      "description": "A device's entry, with the keys the container keeps from its constructor.",
      "properties": {
        "plugin_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The plugin whose manifest lists the component.",
          "title": "Plugin Name"
        },
        "plugin_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The component's id in that manifest.",
          "title": "Plugin Id"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The service whose prefix the device gets.",
          "title": "Service"
        },
        "autoconnect": {
          "default": true,
          "description": "Whether the build connects the device.",
          "title": "Autoconnect",
          "type": "boolean"
        }
      },
      "title": "DeviceEntry",
      "type": "object"
    },
    "LayoutEntry": {
      "additionalProperties": false,
      "description": "The first layout of the window, as a session file writes it.",
      "properties": {
        "regions": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/RowEntry"
              },
              {
                "$ref": "#/$defs/ColumnEntry"
              },
              {
                "$ref": "#/$defs/TabsEntry"
              },
              {}
            ]
          },
          "default": {},
          "description": "What fills each region, by the frontend's region names.",
          "title": "Regions",
          "type": "object"
        },
        "sizes": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "description": "The share of the window each region takes, between 0 and 1.",
          "title": "Sizes",
          "type": "object"
        },
        "hidden": {
          "default": [],
          "description": "The views that start hidden.",
          "items": {
            "type": "string"
          },
          "title": "Hidden",
          "type": "array"
        }
      },
      "title": "LayoutEntry",
      "type": "object"
    },
    "RowEntry": {
      "additionalProperties": false,
      "description": "Views side by side in a layout, as a session file writes them.",
      "properties": {
        "row": {
          "description": "What shares the space, left to right.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/RowEntry"
              },
              {
                "$ref": "#/$defs/ColumnEntry"
              },
              {
                "$ref": "#/$defs/TabsEntry"
              },
              {}
            ]
          },
          "title": "Row",
          "type": "array"
        },
        "sizes": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One positive weight per child.",
          "title": "Sizes"
        }
      },
      "required": [
        "row"
      ],
      "title": "RowEntry",
      "type": "object"
    },
    "StorageConfig": {
      "additionalProperties": false,
      "description": "Where a session writes, and whether it keeps a catalog of its runs.",
      "properties": {
        "base_dir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Root the session writes under; `None` is the user data directory.",
          "title": "Base Dir"
        },
        "max_digits": {
          "default": 5,
          "description": "Width of the counter in file names.",
          "title": "Max Digits",
          "type": "integer"
        },
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The session's catalog, needing the `tiled` extra; `None` for none."
        }
      },
      "title": "StorageConfig",
      "type": "object"
    },
    "TabsEntry": {
      "additionalProperties": false,
      "description": "Views sharing one space as tabs, as a session file writes them.",
      "properties": {
        "tabs": {
          "description": "The views, in the order of their tabs.",
          "items": {
            "type": "string"
          },
          "title": "Tabs",
          "type": "array"
        },
        "current": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The view shown on top; the first when left out.",
          "title": "Current"
        }
      },
      "required": [
        "tabs"
      ],
      "title": "TabsEntry",
      "type": "object"
    },
    "ViewEntry": {
      "additionalProperties": true,
      "description": "A view's entry, with the key the session keeps from its constructor.",
      "properties": {
        "plugin_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The plugin whose manifest lists the component.",
          "title": "Plugin Name"
        },
        "plugin_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The component's id in that manifest.",
          "title": "Plugin Id"
        },
        "placement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the view attaches, as a word or mapping the session's frontend reads.",
          "title": "Placement"
        }
      },
      "title": "ViewEntry",
      "type": "object"
    },
    "HookEntry": {
      "additionalProperties": false,
      "description": "One provider of the `hooks` section, and every hook point it serves.",
      "properties": {
        "provider": {
          "description": "The provider's class, as `module:ClassName`, or a built-in provider's short name.",
          "title": "Provider",
          "type": "string"
        },
        "kwargs": {
          "additionalProperties": true,
          "default": {},
          "description": "Keywords the provider is constructed with.",
          "title": "Kwargs",
          "type": "object"
        }
      },
      "required": [
        "provider"
      ],
      "title": "HookEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A session file, after its layers are merged.",
  "properties": {
    "schema_version": {
      "default": 1.0,
      "description": "The schema the file is written for, one of `SCHEMA_VERSIONS`.",
      "title": "Schema Version",
      "type": "number",
      "enum": [
        1.0
      ]
    },
    "frontend": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "qt"
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The registered frontend the session builds on; the calling class if unset.",
      "title": "Frontend"
    },
    "session": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The session's name, which also names its application; its class's name if unset.",
      "title": "Session"
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "default": {},
          "description": "Metadata of the session.",
          "title": "Metadata",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "strict": {
      "default": false,
      "description": "Whether a component that fails to build or set up stops the session.",
      "title": "Strict",
      "type": "boolean"
    },
    "mock": {
      "default": false,
      "description": "Whether devices connect to simulated backends and no service is launched.",
      "title": "Mock",
      "type": "boolean"
    },
    "services": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "transport": {
              "enum": [
                "channel-access",
                "pv-access"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/ComponentEntry"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "devices": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/DeviceEntry"
          },
          "default": {},
          "description": "Devices by name.",
          "title": "Devices",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "presenters": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ComponentEntry"
          },
          "default": {},
          "description": "Presenters by name.",
          "title": "Presenters",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "views": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ViewEntry"
          },
          "default": {},
          "description": "Views by name.",
          "title": "Views",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "layout": {
      "anyOf": [
        {
          "$ref": "#/$defs/LayoutEntry"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The first layout of the window, in place of the one the session class declares."
    },
    "shortcuts": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ]
      },
      "default": {},
      "description": "Keys by command id, `<component>.<method>`, replacing what the component declares; `null` unbinds.",
      "title": "Shortcuts",
      "type": "object"
    },
    "storage": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where the session writes; the defaults when absent."
    },
    "wiring": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "default": {},
          "description": "The slots each signal reaches, both written as `component.port`.",
          "title": "Wiring",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "pairs": {
      "anyOf": [
        {
          "default": [],
          "description": "Components linked to each other, two names each.\n\nEach signal of one reaches each slot of the other that names it in its\n`signal`, both ways.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Pairs",
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "hooks": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/HookEntry"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ComponentEntry"
      },
      "default": {},
      "description": "Classes registering values the session hands to components, by name.",
      "title": "Providers",
      "type": "object"
    },
    "actions": {
      "default": null,
      "description": "Menu actions the Qt session registers, checked when it reads them.",
      "title": "Actions"
    },
    "color_scheme": {
      "default": null,
      "description": "The Qt session's color scheme, checked when it reads it.",
      "title": "Color Scheme"
    }
  },
  "title": "SessionFile",
  "type": "object"
}
