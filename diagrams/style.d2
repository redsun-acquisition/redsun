# Shared look of every diagram in the docs. A diagram pulls it in with
# `...@diagrams/style` on its first line and gives shapes these classes.

# the site's red, #ef5552, in place of the blue and mauve of the default
# themes; the dark background is the one the site gives its code blocks
vars: {
  d2-config: {
    theme-overrides: {
      B1: "#C62828"
      B2: "#C62828"
      B3: "#FFCDD2"
      B4: "#FFCDD2"
      B5: "#FFEBEE"
      B6: "#FFF5F5"
      N4: "#FFEBEE"
      N5: "#FFEBEE"
      AA2: "#E53935"
      AA4: "#FFEBEE"
      AA5: "#FFF5F5"
      AB4: "#FFEBEE"
      AB5: "#FFF5F5"
    }
    dark-theme-overrides: {
      N1: "#E2E4E9"
      N7: "#14171F"
      B1: "#EF5552"
      B2: "#EF5552"
      B3: "#3A4050"
      B4: "#303542"
      B5: "#262A35"
      B6: "#1D2029"
      N4: "#262A35"
      N5: "#262A35"
      AA2: "#FF8A80"
      AA4: "#262A35"
      AA5: "#1D2029"
      AB4: "#262A35"
      AB5: "#1D2029"
    }
  }
}

classes: {
  layer: {
    style: {
      border-radius: 10
      font-size: 18
      bold: true
    }
  }
  step: {
    style.border-radius: 6
  }
  current: {
    style: {
      border-radius: 6
      stroke-width: 4
      bold: true
      shadow: true
    }
  }
  done: {
    style: {
      border-radius: 6
      opacity: 0.4
    }
  }
  failed: {
    style: {
      border-radius: 6
      stroke: "#c62828"
      stroke-dash: 4
      font-color: "#c62828"
    }
  }
  process: {
    shape: hexagon
  }
  hardware: {
    shape: cylinder
  }
  file: {
    shape: page
  }
  note: {
    shape: text
    style: {
      italic: true
      font-size: 14
    }
  }
  gap: {
    label: ""
    style.opacity: 0
  }
  # a shape a later step brings in: declared on the first board so that every
  # board keeps the same layout, and shown by a step that changes its class
  hidden: {
    style.opacity: 0
  }
  # ports of a component's block, listed as [<kind>; port-left] or
  # [<kind>; port-right]: markdown-d2 moves a shape carrying a port class onto
  # its block's edge, and these two put the name inside the block
  port-left: {label.near: outside-right-center}
  port-right: {label.near: outside-left-center}
  # hollow for what a component takes in, filled for what it gives out; a
  # filled marker is filled by its stroke, which follows the dark theme
  asks: {shape: circle; width: 16; height: 16; style.fill: transparent}
  shares: {shape: circle; width: 8; height: 8; style: {fill: transparent; stroke-width: 8}}
  slot: {shape: square; width: 16; height: 16; style.fill: transparent}
  signal: {shape: square; width: 8; height: 8; style: {fill: transparent; stroke-width: 8}}
}
